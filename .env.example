# VeriLoop configuration. Copy to `.env` (gitignored) and fill in what you have.
# Everything runs with ZERO keys (D-15 keyless-first); each key below only upgrades one integration.
# Empty values mean "use the default". Process environment variables override this file.

# ---- runtime ---------------------------------------------------------------------------------
# Heavy state (embedded Postgres, model weights, media, keys) lives here, outside the repo.
VERILOOP_HOME=C:/Users/lokar/.veriloop
# Empty -> embedded Postgres 16 + pgvector (pgserver) at VERILOOP_HOME/pgdata.
DATABASE_URL=
APP_BASE_URL=http://localhost:8000
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# ---- API -------------------------------------------------------------------------------------
# Comma-separated client keys for X-API-Key (empty = open, rate-limited).
API_KEYS=
# X-Admin-Key for /admin/* (chaos injection). CHANGE THIS before deploying.
ADMIN_KEY=change-me
RATE_LIMIT_PER_MIN=20
MAX_CONCURRENT_JOBS=6

# ---- LLM: aicredits.in only (D-01). Only allowlisted models are ever called. -----------------
# aicredits|none. Empty -> aicredits if LLM_API_KEY is set, else none (extractive mode, labelled in UI).
LLM_PROVIDER=
LLM_BASE_URL=https://api.aicredits.in/v1
LLM_API_KEY=
LLM_ALLOWED_MODELS=gpt-6-luna,5.6-luna
LLM_PRIMARY_MODEL=gpt-6-luna
# Independent second judge (judge consensus only, D-02).
LLM_SECONDARY_MODEL=5.6-luna
LLM_SECOND_JUDGE=true
# Per-attempt deadline in seconds (max_completion_tokens is not reliably enforced upstream).
LLM_TIMEOUT_S=20

# ---- optional keyed integrations (each has a keyless substitute) -----------------------------
# Fact Check Tools API; without it: local ClaimReview feed index (tool claimreview_feed).
GOOGLE_FACTCHECK_API_KEY=
# Cloud Vision web detection; without it: own pHash/CLIP index.
GOOGLE_VISION_API_KEY=
# General search; without it: Google News RSS + Bing News RSS + Wikipedia.
SERPER_API_KEY=
# Commercial deepfake API; without it: local open-model ensemble only.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# Hugging Face token (only for gated models / Inference API; public weights need none).
HF_TOKEN=

# ---- Telegram bot (idle until a BotFather token is set) --------------------------------------
TELEGRAM_BOT_TOKEN=
# polling|webhook
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
# User content is purged after this many hours (G6).
TELEGRAM_TTL_HOURS=24

# ---- audit -----------------------------------------------------------------------------------
# Ed25519 private key PEM; empty -> generated at VERILOOP_HOME/keys/audit_ed25519.pem on first boot.
AUDIT_ED25519_KEY=

# ---- tool flight recorder (D-12) -------------------------------------------------------------
# live | record (live + write cassettes to data/fixtures/cassettes) | replay (cassettes only, "REPLAY MODE")
TOOL_MODE=live

# ---- decision thresholds ---------------------------------------------------------------------
ABSTAIN_THRESHOLD=0.70
CHECKWORTHINESS_THRESHOLD=0.40
MANIPULATION_MIN=0.80
FORENSIC_LOW=0.35
FORENSIC_HIGH=0.70
FORENSIC_DELTA=0.40
NLI_ENTAIL_MIN=0.50

# ---- media limits ----------------------------------------------------------------------------
FRAME_FPS=1
FRAME_CAP=16
AUDIO_CAP_S=90
MAX_UPLOAD_MB=50
MAX_VIDEO_S=900

# ---- local ML --------------------------------------------------------------------------------
ML_ENABLE=true
ML_PREWARM=true
ASR_MODEL=small
EMBED_MODEL=intfloat/multilingual-e5-small
# Verified on the Hub 2026-10-31; label order is read from the model config at load time.
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
# Weights download cache (~1 GB for embedder + NLI). Empty -> VERILOOP_HOME/models.
ML_MODELS_DIR=

WIKIDATA_USER_AGENT=VeriLoop/0.1 (hackathon; contact: team@veriloop.local)
