  "suffix_rules": [
    {
      "suffix": ".gov.in",
      "government_source": true,
      "country": "IN",
      "basis": "registry.gov.in FAQ: GOV.IN names are for Government Organizations as per the registry guidelines.",
      "default_group": "govt_india"
    },
    {
      "suffix": ".nic.in",
      "government_source": true,
      "country": "IN",
      "basis": "nic.in is the National Informatics Centre's domain (www.nic.in redirects to www.nic.gov.in); government bodies are hosted under it (e.g. indianarmy.nic.in, indiacode.nic.in verified). No separate policy document was fetched for .nic.in - treat as strong but not registry-guaranteed.",
      "default_group": "govt_india"
    },
    {
      "suffix": ".mil.in",
      "government_source": null,
      "country": "IN",
      "basis": "Not verified in this pass; do not auto-flag.",
      "default_group": null
    }
  ],
  "state_portal_pattern": {
    "pattern": "<state>.gov.in / <dept>.<state>.gov.in / <state>.nic.in",
    "group": "govt_<state> (e.g. govt_maharashtra); a state government is independent of the central government for corroboration purposes only when the claim is not about the shared programme",
    "note": "Covered by the suffix rules above; no individual state portals were verified in this pass."
  },
  "flagging": "1) Mark evidence items from matching domains (suffix rule OR explicit domain/alias) with government_source=true and show a 'Government source' badge (SPEC 3: 'flag government-source matches explicitly'). 2) Government pages are PRIMARY sources for claims about government actions (a scheme exists, a notice was issued, a date/schedule, an official statistic). 3) They are NOT independent corroboration for claims about the government's own performance or for politically contested claims: count all central-government outlets (PIB, ministries, PMO, Prasar Bharati/DD/AIR, PIB Fact Check) as ONE publisher group 'govt_india'. 4) Wire copies of a PIB release (PTI/ANI/IANS reprints) are syndication of the same source - collapse via syndication.json. 5) Judiciary (sci.gov.in), Parliament (sansad.in), RBI and SEBI get their own groups. 6) PIB Fact Check debunks of fake government notices/schemes count as a fact-check (ClaimReview-equivalent) item with publisher group 'govt_india'.",
