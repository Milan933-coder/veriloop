# Optional frontend settings (Vite exposes only VITE_* to the browser).
# VITE_MOCK=1            # serve fixtures from src/mocks (dev/demo-prep only; flagged in the UI)
# VITE_API_BASE=          # absolute API origin if not same-origin (default: same origin / dev proxy)
# VITE_API_KEY=           # sent as X-API-Key on fetch calls when the backend has API_KEYS set
# Dev proxy target (read by vite.config.ts, not exposed to the browser):
# VERILOOP_API=http://localhost:8000
